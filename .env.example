# ── AI Tutor (server-side only — set in Vercel env vars, or Firebase secrets) ──
# Provide ONE of the following providers (checked in this order).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-haiku-latest          # optional override

# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx        # alternative provider
# OPENAI_MODEL=gpt-4o-mini                           # optional override

# GEMINI_API_KEY=AIza...                             # Google Gemini (great on Firebase)
# GEMINI_MODEL=gemini-2.0-flash                      # optional override
# (GOOGLE_API_KEY is also accepted as an alias for GEMINI_API_KEY)

# On Firebase, set these as secrets instead of plain env, e.g.:
#   firebase functions:secrets:set GEMINI_API_KEY

# NOTE: The Firebase web config is public and lives in src/environments/ — it does NOT belong here.
